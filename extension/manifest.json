{
  "manifest_version": 3,
  "name": "langtube",
  "version": "0.1.0",
  "action": { "default_title": "Open learning panel" },
  "key": "",
  "oauth2": {
    "client_id": "dhaodjckbbpdfimhplhdlhkcjpibnicc.apps.googleusercontent.com",
    "scopes": ["openid", "email", "profile"]
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+L" },
      "description": "Toggle the learning panel"
    }
  },
  "background": { "service_worker": "src/background.ts", "type": "module" },
  "permissions": ["storage", "identity"],
  "host_permissions": ["https://www.youtube.com/*", "http://localhost/*", "http://127.0.0.1/*"],
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*"], "js": ["src/main-world.ts"], "world": "MAIN", "run_at": "document_start" },
    { "matches": ["https://www.youtube.com/*"], "js": ["src/content.ts"], "run_at": "document_idle" }
  ]
}