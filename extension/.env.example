# Same Web application OAuth client as GOOGLE_WEB_CLIENT_ID in the backend.
# In Google Cloud, add the URL returned by chrome.identity.getRedirectURL('google-auth')
# to this client's Authorized redirect URIs. See SIDEBAR.md.
VITE_GOOGLE_CLIENT_ID=

# Optional deployed HTTPS origins:
VITE_BACKEND_URL=
VITE_DASHBOARD_URL=
