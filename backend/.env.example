ELEVENLABS_API_KEY=
GEMINI_API_KEY=
DATABASE_URL=
# Alternative: shared project .env uses this name.
TIGER_DATA_CONNECTION_STRING=

# Google sign-in. SESSION_SECRET signs session tokens: use a long random value
# (e.g. `openssl rand -hex 32`) and never commit it.
SESSION_SECRET=
# OAuth client of type "Chrome Extension" (same value as oauth2.client_id in extension/manifest.json).
GOOGLE_EXTENSION_CLIENT_ID=428266368805-98d7reo8ea0fu89va3i1sbfqfbredcag.apps.googleusercontent.com
# OAuth client of type "Web application" used by the dashboard's Sign in with Google button.
GOOGLE_WEB_CLIENT_ID=

# OPTIONAL FIELDS
ELEVENLABS_VOICE_ID=
# Fast Spanish practice audio; use eleven_multilingual_v2 for expressive delivery.
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
GEMINI_MODEL=
# Local testing only: set LLM_PROVIDER=ollama to translate/explain with a local Ollama model
# instead of Gemini. Leave unset in production.
LLM_PROVIDER=
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_URL=http://localhost:11434
PORT=3000
# Optional trusted service CA file for private/self-signed certificate chains.
PGSSLROOTCERT=

# AI_PROVIDER takes priority over the compatible LLM_PROVIDER setting.
AI_PROVIDER=
OLLAMA_BASE_URL=http://127.0.0.1:11434
