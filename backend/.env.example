ELEVENLABS_API_KEY=
GEMINI_API_KEY=
DATABASE_URL=
# Alternative: shared project .env uses this name.
TIGER_DATA_CONNECTION_STRING=

# OPTIONAL FIELDS
ELEVENLABS_VOICE_ID=
GEMINI_MODEL=
# Local testing only: set LLM_PROVIDER=ollama to translate/explain with a local Ollama model
# instead of Gemini. Leave unset in production.
LLM_PROVIDER=
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_URL=http://localhost:11434
PORT=3000
# Optional trusted service CA file for private/self-signed certificate chains.
PGSSLROOTCERT=

# AI_PROVIDER takes priority over the compatible LLM_PROVIDER setting.
AI_PROVIDER=
OLLAMA_BASE_URL=http://127.0.0.1:11434
